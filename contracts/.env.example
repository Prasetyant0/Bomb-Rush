# Monad network

# Monad Testnet — the only network this build targets.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer key. Becomes the contract owner, so it must be the same key the game
# server holds as SERVER_SIGNER_PRIVATE_KEY. Never commit a filled-in value.
PRIVATE_KEY=

# Filled in after `forge script ... --broadcast`.
MATCH_REGISTRY_ADDRESS=

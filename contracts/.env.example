# Monad network

# Monad Testnet — the only network this build targets.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Deployer key → DEFAULT_ADMIN_ROLE. Keep cold; it can cancel rooms.
# Never commit a filled-in value.
PRIVATE_KEY=

# Address that receives DEFAULT_ADMIN_ROLE. Defaults to the deployer address.
ADMIN_ADDRESS=

# Server hot key → SETTLER_ROLE. Must differ from the admin address.
# This is the same address the game server holds as SERVER_SETTLER_PRIVATE_KEY.
SETTLER_ADDRESS=

# Entry bounds and windows. Defaults match DECISIONS.md; override only for rehearsal.
ENTRY_MIN_WEI=1000000000000000
ENTRY_MAX_WEI=10000000000000000
FUNDING_WINDOW_SEC=600
RESOLUTION_WINDOW_SEC=1200

# Filled in after `forge script ... --broadcast`.
ESCROW_ADDRESS=
ESCROW_DEPLOYMENT_BLOCK=

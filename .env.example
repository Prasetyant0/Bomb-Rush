# BOMB RUSH 3D server — copy to .env and fill in. Never commit the real .env.
PORT=3000
HOST=0.0.0.0
ROOM_EXPIRY_SECONDS=600
COUNTDOWN_SECONDS=15
ALLOW_DEMO_BOT=true
ENABLE_REAL_VALUE_STAKES=false

# Monad Testnet RPC endpoint.
# On-chain result recording is not implemented yet.
MONAD_RPC_URL=

# Reserved for future PostgreSQL persistence.
# Current room state is stored in memory.
DATABASE_URL=

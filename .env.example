# BOMB RUSH 3D — copy to .env. Never commit the filled-in file.
#
# Three parts read this: the server (`apps/server`), the frontend at build/serve
# time (`apps/web`), and the deploy script (`contracts/`). Values that look like
# secrets stay server-side only.

# ---------------------------------------------------------------- server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
ROOM_EXPIRY_SECONDS=600
COUNTDOWN_SECONDS=15

# Demo bot filling a seat. v0.5 DECISIONS D02 says no bot in a funded P0 match;
# leaving this true contradicts the spec. Set false before a funded demo.
ALLOW_DEMO_BOT=false

# ---------------------------------------------------------------- chain
# All three are required for the funded flow. If ESCROW_ADDRESS or
# SERVER_SETTLER_PRIVATE_KEY is empty, the server runs with the chain module
# disabled and the UI must say so — the game still runs.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# From `forge script script/Deploy.s.sol:Deploy ... --broadcast`.
# VERIFIED ON CHAIN (cast): do NOT take these from contracts/broadcast/*
# run-latest.json — local anvil runs share chainId 10143 and pollute it.
#   ADMIN  0xAf836EfF9F9bC39E00576ec4af36053dfeF6ABf2 (DEFAULT_ADMIN_ROLE)
#   SETTLER 0x3419163ffE7D12Dc3b08187B3fBC2E622e1D29aD (SETTLER_ROLE)
# entryBounds() = 1e15..1e16 wei; admin != settler.
ESCROW_ADDRESS=0x8c839fab937a08177c2779eef36c15d8999be8fe
# Block the deploy landed in — bounds eth_getLogs during recovery. Not the
# current block.
ESCROW_DEPLOYMENT_BLOCK=73756739

# Server hot key. Holds SETTLER_ROLE only. Must NOT be the admin key.
# Never in a frontend bundle, never in a commit, never in a log.
SERVER_SETTLER_PRIVATE_KEY=

# ---------------------------------------------------------------- frontend
# Consumed by apps/web when served. Public by definition — no secrets here.
VITE_CHAIN_ID=10143
VITE_ESCROW_ADDRESS=
VITE_SERVER_ORIGIN=http://localhost:3000
# Set to 1 to use the Socket.IO server, 0 to keep the offline local sim.
VITE_NET_MODE=0

# ---------------------------------------------------------------- not used
# SQLite/Drizzle and any database remain out of scope: room state is in memory,
# and the contract is the only durable record.
